# ============================================================================
# Crypto Trading Signal Bot – configuration
# Copy to `.env` and fill in the values.  Everything except the Binance /
# Telegram credentials has a sensible default.
# ============================================================================

# --- Exchange ---------------------------------------------------------------
# Public market data does NOT require API keys. Keys are optional (used only
# to raise rate limits / for future order execution).
BINANCE_API_KEY=
BINANCE_SECRET=
# true  -> https://testnet.binancefuture.com  (paper / testing)
# false -> https://fapi.binance.com           (live market data)
BINANCE_TESTNET=true
# binance (default) | synthetic (offline demo data – no internet needed)
DATA_SOURCE=binance
# Real-time kline streaming over WebSocket (REST fallback is automatic)
ENABLE_WEBSOCKET=true

# --- Database ---------------------------------------------------------------
# Used by docker-compose to create the PostgreSQL container
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=crypto_password_123
POSTGRES_DB=crypto_signals
# Used when running the backend/dashboard outside Docker
DATABASE_URL=postgresql://crypto_user:crypto_password_123@localhost:5432/crypto_signals

# --- Telegram ---------------------------------------------------------------
# 1. Create a bot with @BotFather  -> token (the only value you must provide)
# 2. Create a channel (or group) and add the bot as ADMINISTRATOR with
#    "Post messages". The bot discovers the channel automatically within a
#    minute and starts posting there.  Optional: send /start to the bot in a
#    private chat to also receive operational alerts there.
# 3. TELEGRAM_CHANNEL_ID / TELEGRAM_ADMIN_CHAT_ID may be set explicitly to
#    override auto-discovery (public channel -> @name ; private -> -100xxxxxxxxxx)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
NOTIFY_TP_UPDATES=true
NOTIFY_STARTUP=true
# Hour (UTC) for the daily summary message, -1 to disable
DAILY_SUMMARY_HOUR_UTC=0

# --- Trading universe -------------------------------------------------------
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
TIMEFRAME=15m
CONFIRMATION_TIMEFRAMES=1h,4h
# Seconds between screening cycles (default = timeframe length, aligned to candle close)
SCREENING_INTERVAL=900
# Seconds to wait after candle close before fetching (lets the exchange finalise the candle)
CANDLE_CLOSE_DELAY_SECONDS=8
# Candles loaded per timeframe (indicator warm-up)
KLINE_LIMIT=300

# --- Indicators -------------------------------------------------------------
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD=2.0
ATR_PERIOD=14
EMA_PERIODS=9,21,50
VOLUME_AVG_PERIOD=20
VOLUME_SPIKE_MULTIPLIER=1.5

# --- Signal logic -----------------------------------------------------------
# Minimum number of the 3 primary conditions (RSI / MACD cross / Bollinger)
MIN_CONDITIONS=2
# MACD crossover must have happened within the last N closed candles (0 = state only)
MACD_CROSS_LOOKBACK=3
# Discard signals whose conviction score is below this (0-100)
MIN_CONVICTION=40
# Require the 1h EMA trend to agree with the signal direction
REQUIRE_HTF_CONFIRMATION=false

# --- Risk management --------------------------------------------------------
SL_ATR_MULT=2.0
TP1_ATR_MULT=2.0
TP2_ATR_MULT=4.0
TP3_ATR_MULT=6.0
MOVE_SL_TO_BREAKEVEN_AFTER_TP1=true
MAX_ACTIVE_SIGNALS=10
ONE_SIGNAL_PER_SYMBOL=true
# Minutes to wait after a signal on a symbol before another one may be issued
SIGNAL_COOLDOWN_MINUTES=60
# Signals still open after this many hours are closed at market ("time stop")
SIGNAL_EXPIRY_HOURS=48
# Used for the position-size hint in Telegram messages (2% = 0.02)
RISK_PER_TRADE=0.02
# Seconds between TP/SL checks of active signals
MONITOR_INTERVAL=60

# --- Application ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Protects POST /api/admin/* endpoints (leave empty to disable protection)
ADMIN_TOKEN=
# Dashboard: backend API base URL (docker-compose sets this automatically)
API_URL=http://localhost:8000
DASHBOARD_REFRESH_SECONDS=60
