# Inventori rahsia GridBot Signal — NAMA sahaja, JANGAN isi nilai sebenar.
# Nilai sebenar: pengguna beri terus kepada Operator GPT / dashboard.

# Supabase (wajib untuk Cloud Sync; dapat dari Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase service role (Fasa 2: edge functions yang memintas RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram alerts (Fasa 2: dari @BotFather + chat id pengguna)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel cron (Fasa 2: jana rawak, set sebagai env + header semakan)
CRON_SECRET=
