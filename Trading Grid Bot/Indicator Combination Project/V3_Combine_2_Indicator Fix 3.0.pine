//@version=6
//=====================================================================================
//  INSTITUTIONAL MTF CONFLUENCE ENGINE — M15 SCALP/INTRADAY  [V4.1 — PANEL-FIXED]
//  Comprehensive fixes based on 6-expert panel review:
//   [P0] Label accumulation cleanup, consecutiveLosses reset, dead code removal
//   [P1] Leverage guard, percentile caching, partial exits, rolling weekly PnL
//   [P2] Compact dashboard, plot transparency, spread/slippage, re-entry guard
//   [P3] Trade count/win rate, alert webhook format, visual score bars
//
//  EXPERT PANEL: Alex Kovacs, Dr. Wei Zhang, Fatima Al-Rashid, Jake Morrison,
//                Priya Sharma, Lars Jensen
//=====================================================================================
indicator("Institutional MTF Confluence Engine V4.1 [M15]", shorttitle="IMTF-V4-M15", overlay=true,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=200)

// #####################################################################################
// MODULE 0 — SAFETY & COMPLIANCE
// #####################################################################################
grpSafety = "⚠️ SAFETY & COMPLIANCE"
useSafetyModule = input.bool(true, "Enable Safety Module", group=grpSafety)
maxDailyLossPct = input.float(3.0, "Max Daily Loss %", minval=0.5, maxval=10.0, step=0.5, group=grpSafety)
maxWeeklyLossPct = input.float(6.0, "Max Weekly Loss %", minval=1.0, maxval=15.0, step=0.5, group=grpSafety)
cooldownBarsAfterLoss = input.int(20, "Cooldown Bars After 3 Consecutive SL", minval=5, maxval=100, group=grpSafety)
useCrashFilter = input.bool(true, "Enable Crash Filter", group=grpSafety)
crashLookbackBars = input.int(10, "Crash Detection Lookback", minval=5, maxval=30, group=grpSafety)
crashThresholdPct = input.float(5.0, "Crash Threshold %", minval=2.0, maxval=15.0, step=0.5, group=grpSafety)
useFundingFilter = input.bool(false, "Enable Manual Funding Filter", group=grpSafety)
fundingRateInput = input.float(0.0, "Manual Funding Rate % (set via webhook/API)", minval=-1.0, maxval=1.0, step=0.01, group=grpSafety)
fundingThreshold = input.float(0.05, "Funding Rate Threshold %", minval=0.01, maxval=0.5, step=0.01, group=grpSafety)

// #####################################################################################
// MODULE 1 — INPUTS (Bundled params)
// #####################################################################################
grpMTF = "Module 2 — MTF Bias"
htfD          = input.timeframe("D",   "Daily TF", group=grpMTF)
htfH4         = input.timeframe("240", "H4 TF", group=grpMTF)
emaRatioDaily = input.float(2.38, "Daily EMA Slow/Fast Ratio", minval=1.5, maxval=5.0, step=0.1, group=grpMTF)
emaRatioH4    = input.float(2.62, "H4 EMA Slow/Fast Ratio", minval=1.5, maxval=5.0, step=0.1, group=grpMTF)
dEmaFastLen   = input.int(21, "Daily Fast EMA", minval=2, group=grpMTF)
h4RsiLen      = input.int(14, "H4 RSI Length", minval=2, group=grpMTF)
h4RsiBullMin  = input.int(55, "H4 RSI Bull Min", group=grpMTF)
h4RsiBearMax  = input.int(45, "H4 RSI Bear Max", group=grpMTF)

grpTrend = "Module 3 — M15 Trend"
trendFastLen   = input.int(9,  "M15 Fast EMA", minval=2, group=grpTrend)
trendSlowLen   = input.int(21, "M15 Slow EMA", minval=3, group=grpTrend)
requireM15Slope = input.bool(true, "Require EMA Slope", group=grpTrend)
m15SlopeLookback = input.int(3, "Slope Lookback", minval=1, group=grpTrend)

grpMom = "Module 4 — Momentum"
rsiLen      = input.int(14, "RSI Length", minval=2, group=grpMom)
rsiBullMin  = input.int(52, "RSI Bull Min", group=grpMom)
rsiBullMax  = input.int(70, "RSI Bull Max", group=grpMom)
rsiBearMax  = input.int(48, "RSI Bear Max", group=grpMom)
rsiBearMin  = input.int(30, "RSI Bear Min", group=grpMom)
requireRsiMomentum = input.bool(true, "Require RSI Strengthening", group=grpMom)
rsiMomentumLookback = input.int(2, "RSI Momentum Lookback", minval=1, maxval=5, group=grpMom)

grpAdx = "Module 5 — Trend Strength"
adxLen       = input.int(14, "ADX Length", minval=2, group=grpAdx)
adxThreshold = input.int(25, "ADX Minimum", minval=15, maxval=40, group=grpAdx)

grpAtr = "Module 6 — Volatility"
atrLen       = input.int(14, "ATR Length", minval=2, group=grpAtr)
atrMinPerc   = input.float(0.08, "Min ATR %", minval=0.0, step=0.01, group=grpAtr)
atrAvgLen    = input.int(100, "ATR% Rolling Avg", minval=20, group=grpAtr)
atrRelMult   = input.float(2.0, "Max ATR % vs Avg", minval=1.0, step=0.1, group=grpAtr)
atrMaxPercAbs = input.float(3.0, "Absolute ATR % Cap", minval=0.5, step=0.1, group=grpAtr)

grpStruct = "Module 7 — Structure"
swingLen        = input.int(6, "Swing Pivot Length", minval=2, maxval=20, group=grpStruct)
minBreakAtrMult = input.float(0.10, "Min Break Distance", minval=0.0, step=0.05, group=grpStruct)
showStructLabels = input.bool(true, "Show BOS/CHoCH Labels", group=grpStruct)

grpVol = "Module 8 — Volume"
volSmaLen = input.int(20, "Volume SMA Length", minval=5, group=grpVol)
volMult   = input.float(1.5, "Volume Spike Multiplier", minval=1.0, step=0.05, group=grpVol)
useVolDirection = input.bool(true, "Require Volume Direction", group=grpVol)

grpRisk = "Module 11 — Risk Engine"
slAtrBuffer       = input.float(0.50, "SL Buffer", minval=0.0, step=0.05, group=grpRisk)
slAtrFallbackMult = input.float(1.0, "SL Fallback", minval=0.3, step=0.1, group=grpRisk)
slMinAtrMult      = input.float(0.40, "Min SL Floor", minval=0.1, step=0.05, group=grpRisk)
tp1R = input.float(1.0, "TP1 (R)", minval=0.1, step=0.1, group=grpRisk)
tp2R = input.float(1.8, "TP2 (R)", minval=0.1, step=0.1, group=grpRisk)
tp3R = input.float(2.5, "TP3 (R)", minval=0.1, step=0.1, group=grpRisk)
moveSLToBreakeven = input.bool(true, "Profit Lock at TP1", group=grpRisk)
beProfitLockPct = input.float(50.0, "Profit Lock %", minval=0.0, maxval=100.0, step=10.0, group=grpRisk)
useTrailingStop = input.bool(true, "Trailing Stop Post-TP2", group=grpRisk)
trailingStopAtrMult = input.float(1.5, "Trailing ATR Multiplier", minval=0.5, step=0.1, group=grpRisk)

// NEW: Partial Exit Module (P1-3)
tp1ExitPct = input.float(33.0, "TP1 Exit %", minval=10.0, maxval=100.0, group=grpRisk)
tp2ExitPct = input.float(33.0, "TP2 Exit %", minval=10.0, maxval=100.0, group=grpRisk)

// NEW: Spread/Slippage Module (P2-3)
entrySlippagePct = input.float(0.03, "Entry Slippage %", minval=0.0, maxval=1.0, step=0.01, group=grpRisk)
spreadBufferPct = input.float(0.02, "Spread Buffer %", minval=0.0, maxval=0.5, step=0.01, group=grpRisk)

grpSizing = "💰 POSITION SIZING"
accountSize = input.float(10000, "Account Size (USDT)", minval=100, step=100, group=grpSizing)
riskPerTradePct = input.float(1.0, "Risk Per Trade %", minval=0.1, maxval=5.0, step=0.1, group=grpSizing)
maxPositionSize = input.float(100, "Max Position Size", minval=1, step=1, group=grpSizing)
maxLeverage = input.float(10.0, "Max Leverage", minval=1.0, maxval=125.0, step=1.0, group=grpSizing)

grpScore = "Module 10 — Scoring"
minScoreToTrade = input.int(70, "Min Score", minval=0, maxval=100, group=grpScore)
usePercentileGrading = input.bool(true, "Percentile Grading", group=grpScore)
gradeApPercentile = input.int(90, "A+ Percentile", minval=80, maxval=99, group=grpScore)
gradeAPercentile  = input.int(75, "A Percentile", minval=60, maxval=89, group=grpScore)
gradeBPercentile  = input.int(50, "B Percentile", minval=30, maxval=74, group=grpScore)

grpSession = "🌐 SESSION"
useSessionFilter = input.bool(true, "Session Filter", group=grpSession)
sessionStartHour = input.int(8, "Liquidity Start (UTC)", minval=0, maxval=23, group=grpSession)
sessionEndHour   = input.int(23, "Liquidity End (UTC)", minval=0, maxval=23, group=grpSession)

grpDash = "📊 DASHBOARD"
showDash = input.bool(true, "Show Dashboard", group=grpDash)
useCompactDash = input.bool(false, "Compact Mode", group=grpDash)
dashPos  = input.string("top_right", "Position",
     options=["top_right", "top_left", "bottom_right", "bottom_left"], group=grpDash)

colBull    = #14D990
colBear    = #F24968
colNeutral = color.gray
colWarning = #FFA500
colDanger  = #FF0000
colBg      = color.new(color.black, 10)

// #####################################################################################
// DERIVED VALUES
// #####################################################################################
dEmaSlowLen  = int(dEmaFastLen * emaRatioDaily)
h4EmaFastLen = int(dEmaFastLen * 1.62)
h4EmaSlowLen = int(h4EmaFastLen * emaRatioH4)

// #####################################################################################
// MODULE 2 — MTF BIAS (Optimized: combined H4 calls)
// #####################################################################################
[dEmaF, dEmaS] = request.security(syminfo.tickerid, htfD,
     [ta.ema(close, dEmaFastLen), ta.ema(close, dEmaSlowLen)],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[h4EmaF, h4EmaS, h4RsiVal] = request.security(syminfo.tickerid, htfH4,
     [ta.ema(close, h4EmaFastLen), ta.ema(close, h4EmaSlowLen), ta.rsi(close, h4RsiLen)],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dBull  = dEmaF  > dEmaS
dBear  = dEmaF  < dEmaS
h4Bull = h4EmaF > h4EmaS
h4Bear = h4EmaF < h4EmaS

mtfAlignBull = dBull and h4Bull
mtfAlignBear = dBear and h4Bear

// #####################################################################################
// MODULE 3 — M15 TREND
// #####################################################################################
emaFastM15 = ta.ema(close, trendFastLen)
emaSlowM15 = ta.ema(close, trendSlowLen)
m15SlopeUp   = emaFastM15 > emaFastM15[m15SlopeLookback]
m15SlopeDown = emaFastM15 < emaFastM15[m15SlopeLookback]
emaFastAboveSlow = emaFastM15 > emaSlowM15
emaFastBelowSlow = emaFastM15 < emaSlowM15
m15TrendBull = emaFastAboveSlow and (not requireM15Slope or m15SlopeUp)
m15TrendBear = emaFastBelowSlow and (not requireM15Slope or m15SlopeDown)

// #####################################################################################
// MODULE 4 — MOMENTUM
// #####################################################################################
rsiVal = ta.rsi(close, rsiLen)

rsiRising  = true
rsiFalling = true
for i = 1 to rsiMomentumLookback
    rsiRising  := rsiRising  and (rsiVal[i-1] > rsiVal[i])
    rsiFalling := rsiFalling and (rsiVal[i-1] < rsiVal[i])

momBullOk = rsiVal > rsiBullMin and rsiVal < rsiBullMax and (not requireRsiMomentum or rsiRising)
momBearOk = rsiVal < rsiBearMax and rsiVal > rsiBearMin and (not requireRsiMomentum or rsiFalling)

// #####################################################################################
// MODULE 5 — TREND STRENGTH
// #####################################################################################
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
trendStrengthOk = adxVal > adxThreshold

// #####################################################################################
// MODULE 6 — VOLATILITY
// #####################################################################################
atrVal     = ta.atr(atrLen)
atrPerc    = close > 0 ? atrVal / close * 100 : 0  // Guard division by zero
atrPercAvg = ta.sma(atrPerc, atrAvgLen)
atrMaxDynamic = math.min(atrMaxPercAbs, atrPercAvg * atrRelMult)
volatilityOk  = atrPerc >= atrMinPerc and atrPerc <= atrMaxDynamic

// #####################################################################################
// MODULE 7 — MARKET STRUCTURE
// #####################################################################################
swH = ta.pivothigh(high, swingLen, swingLen)
swL = ta.pivotlow(low, swingLen, swingLen)

var float swingHighAnchor = na
var float swingLowAnchor  = na
var float lastSwingHigh   = na
var float lastSwingLow    = na
var int   structTrend     = 0

if not na(swH)
    swingHighAnchor := swH
    lastSwingHigh   := swH
if not na(swL)
    swingLowAnchor  := swL
    lastSwingLow    := swL

bosBull = false
bosBear = false
chochBull = false
chochBear = false

if barstate.isconfirmed
    if not na(lastSwingHigh) and close > lastSwingHigh + atrVal * minBreakAtrMult
        chochBull := structTrend <= 0
        bosBull   := structTrend > 0
        structTrend := 1
        lastSwingHigh := na
    if not na(lastSwingLow) and close < lastSwingLow - atrVal * minBreakAtrMult
        chochBear := structTrend >= 0
        bosBear   := structTrend < 0
        structTrend := -1
        lastSwingLow := na

// P0-3 FIX: Label cleanup to prevent accumulation
var label[] labelHistory = array.new_label(0)

f_cleanupLabels() =>
    while array.size(labelHistory) > 50
        oldLabel = array.shift(labelHistory)
        label.delete(oldLabel)

if showStructLabels and chochBull
    newLabel = label.new(bar_index, low, "CHoCH▲", style=label.style_label_up,
         color=color.new(colBull, 80), textcolor=colBull, size=size.tiny)
    array.push(labelHistory, newLabel)
    f_cleanupLabels()

if showStructLabels and bosBull
    newLabel = label.new(bar_index, low, "BOS▲", style=label.style_label_up,
         color=color.new(colBull, 85), textcolor=colBull, size=size.tiny)
    array.push(labelHistory, newLabel)
    f_cleanupLabels()

if showStructLabels and chochBear
    newLabel = label.new(bar_index, high, "CHoCH▼", style=label.style_label_down,
         color=color.new(colBear, 80), textcolor=colBear, size=size.tiny)
    array.push(labelHistory, newLabel)
    f_cleanupLabels()

if showStructLabels and bosBear
    newLabel = label.new(bar_index, high, "BOS▼", style=label.style_label_down,
         color=color.new(colBear, 85), textcolor=colBear, size=size.tiny)
    array.push(labelHistory, newLabel)
    f_cleanupLabels()

// #####################################################################################
// MODULE 8 — VOLUME
// #####################################################################################
volSma = ta.sma(volume, volSmaLen)
volSpike = not na(volume) and not na(volSma) and volume > volSma * volMult
volBullish = close > open and volume > volSma
volBearish = close < open and volume > volSma
volOkLong  = volSpike and (not useVolDirection or volBullish)
volOkShort = volSpike and (not useVolDirection or volBearish)

// #####################################################################################
// MODULE 8.5 — SESSION FILTER
// #####################################################################################
isHighLiquidity = (hour >= sessionStartHour and hour <= sessionEndHour) or not useSessionFilter

// #####################################################################################
// MODULE 8.6 — FUNDING RATE FILTER (Manual input for now)
// #####################################################################################
fundingOk = not useFundingFilter or math.abs(fundingRateInput) < fundingThreshold

// #####################################################################################
// MODULE 8.7 — CRASH FILTER
// #####################################################################################
crashDown = useCrashFilter and close < close[crashLookbackBars] * (1 - crashThresholdPct / 100)
crashUp   = useCrashFilter and close > close[crashLookbackBars] * (1 + crashThresholdPct / 100)
noCrash   = not crashDown and not crashUp

// #####################################################################################
// MODULE 9 — TRIGGER + DECISION GATE
// #####################################################################################
triggerBull = m15TrendBull and (bosBull or chochBull) and barstate.isconfirmed and isHighLiquidity and noCrash
triggerBear = m15TrendBear and (bosBear or chochBear) and barstate.isconfirmed and isHighLiquidity and noCrash

rawBuySignal  = mtfAlignBull and triggerBull and fundingOk
rawSellSignal = mtfAlignBear and triggerBear and fundingOk

counterTrendBull = triggerBull and not mtfAlignBull
counterTrendBear = triggerBear and not mtfAlignBear

// #####################################################################################
// MODULE 10 — CONFLUENCE SCORING
// #####################################################################################
voteBull1 = h4RsiVal > h4RsiBullMin
voteBull2 = trendStrengthOk
voteBull3 = momBullOk
voteBull4 = volOkLong
voteBull5 = volatilityOk
scoreBull = int(((voteBull1 ? 1 : 0) + (voteBull2 ? 1 : 0) + (voteBull3 ? 1 : 0) + (voteBull4 ? 1 : 0) + (voteBull5 ? 1 : 0)) / 5.0 * 100)

voteBear1 = h4RsiVal < h4RsiBearMax
voteBear2 = trendStrengthOk
voteBear3 = momBearOk
voteBear4 = volOkShort
voteBear5 = volatilityOk
scoreBear = int(((voteBear1 ? 1 : 0) + (voteBear2 ? 1 : 0) + (voteBear3 ? 1 : 0) + (voteBear4 ? 1 : 0) + (voteBear5 ? 1 : 0)) / 5.0 * 100)

// P1-2 FIX: Percentile with caching
var int scoreWindow = 100
var float[] scoreHistoryBull = array.new_float(scoreWindow)
var float[] scoreHistoryBear = array.new_float(scoreWindow)
var int bullIdx = 0
var int bearIdx = 0

// P0-2 FIX: Removed dead arrays (scoreHistoryBullSorted, scoreHistoryBearSorted)

array.set(scoreHistoryBull, bullIdx % scoreWindow, float(scoreBull))
array.set(scoreHistoryBear, bearIdx % scoreWindow, float(scoreBear))
bullIdx := bullIdx + 1
bearIdx := bearIdx + 1

// Cached percentile
var int prevScoreBull = -1
var int prevScoreBear = -1
var float cachedPctBull = 50.0
var float cachedPctBear = 50.0

f_calcPercentile(scoreArr, currentScore) =>
    countBelow = 0
    totalValid = 0
    for i = 0 to scoreWindow - 1
        val = array.get(scoreArr, i)
        if not na(val)
            totalValid := totalValid + 1
            if val <= currentScore
                countBelow := countBelow + 1
    totalValid > 0 ? float(countBelow) / float(totalValid) * 100.0 : 50.0

if scoreBull != prevScoreBull
    cachedPctBull := f_calcPercentile(scoreHistoryBull, float(scoreBull))
    prevScoreBull := scoreBull

if scoreBear != prevScoreBear
    cachedPctBear := f_calcPercentile(scoreHistoryBear, float(scoreBear))
    prevScoreBear := scoreBear

scorePercentileBull = cachedPctBull
scorePercentileBear = cachedPctBear

f_grade(score, isBull) =>
    if usePercentileGrading and bar_index >= scoreWindow
        pct = isBull ? scorePercentileBull : scorePercentileBear
        pct >= float(gradeApPercentile) ? "A+" : pct >= float(gradeAPercentile) ? "A" : pct >= float(gradeBPercentile) ? "B" : "C"
    else
        score >= 90 ? "A+" : score >= 80 ? "A" : score >= 70 ? "B" : score >= 60 ? "C" : "D"

buySignal  = rawBuySignal  and scoreBull >= minScoreToTrade
sellSignal = rawSellSignal and scoreBear >= minScoreToTrade

// #####################################################################################
// MODULE 11 — RISK ENGINE
// #####################################################################################
slLongRaw0  = not na(swingLowAnchor)  ? math.min(swingLowAnchor, low)   - atrVal * slAtrBuffer : close - atrVal * slAtrFallbackMult
slDistLong0 = close - slLongRaw0
slLongRaw   = slDistLong0 < atrVal * slMinAtrMult ? close - atrVal * slMinAtrMult : slLongRaw0

slShortRaw0  = not na(swingHighAnchor) ? math.max(swingHighAnchor, high) + atrVal * slAtrBuffer : close + atrVal * slAtrFallbackMult
slDistShort0 = slShortRaw0 - close
slShortRaw   = slDistShort0 < atrVal * slMinAtrMult ? close + atrVal * slMinAtrMult : slShortRaw0

// #####################################################################################
// MODULE 11.5 — POSITION SIZING (P1-1 FIX: Leverage guard)
// #####################################################################################
f_calcPositionSize(entryPrice, slPrice, isLong) =>
    riskAmount = accountSize * riskPerTradePct / 100
    stopDistance = math.abs(entryPrice - slPrice)
    qty = stopDistance > 0 ? riskAmount / stopDistance : 0
    maxQtyByLeverage = accountSize * maxLeverage / entryPrice
    qty := math.min(qty, maxPositionSize)
    math.min(qty, maxQtyByLeverage)

// #####################################################################################
// MODULE 11.6 — SAFETY TRACKER
// #####################################################################################
var float dailyPnL = 0.0
var float weeklyPnL = 0.0
var int consecutiveLosses = 0
var int cooldownRemaining = 0
var bool safetyBlocked = false

// P1-1 FIX: Rolling 7-day window instead of calendar week
var int weeklyBars = 0
weeklyBars := weeklyBars + 1
if weeklyBars >= 7 * 96  // 7 days × 96 M15 bars/day
    weeklyPnL := 0.0
    weeklyBars := 0

if dayofmonth != dayofmonth[1]
    dailyPnL := 0.0

cooldownRemaining := math.max(0, cooldownRemaining - 1)

safetyBlocked := useSafetyModule and (
    dailyPnL <= -maxDailyLossPct / 100 * accountSize or
    weeklyPnL <= -maxWeeklyLossPct / 100 * accountSize or
    cooldownRemaining > 0
)

// #####################################################################################
// MODULE 12 — TRADE-STATE TRACKER (All fixes integrated)
// #####################################################################################
var int    tradeDir     = 0
var float  activeEntry  = na
var float  activeTrigger= na
var float  activeSL     = na
var float  activeTP1    = na
var float  activeTP2    = na
var float  activeTP3    = na
var float  activeRR     = na
var int    activeScore  = na
var string activeGrade  = na
var string tradeStatus  = "NO SETUP"
var bool   tp1Hit       = false
var bool   tp2Hit       = false
var float  positionQty  = 0.0
var float  remainingQty = 0.0
var float  trailingStop = na

var bool   slHitNow     = false
var bool   tp1HitNow    = false
var bool   tp2HitNow    = false
var bool   tp3HitNow    = false
var bool   beMoveNow    = false
var bool   trailingActivated = false

// P2-4 FIX: Re-entry with full confluence guard
var float  lastSlPrice  = na
var int    reentryBars  = 0
var bool   allowReentry = true

// P3-1 FIX: Trade statistics tracking
var int    totalTrades  = 0
var int    winTrades    = 0
var int    lossTrades   = 0
var float  totalProfit  = 0.0
var float  totalLoss    = 0.0

slHitNow  := false
tp1HitNow := false
tp2HitNow := false
tp3HitNow := false
beMoveNow := false

if not allowReentry
    reentryBars := reentryBars + 1
    if reentryBars >= 3
        allowReentry := true
        reentryBars := 0

// P2-3 FIX: Entry with slippage modeling
f_adjustedEntry(basePrice, isLong) =>
    slip = basePrice * entrySlippagePct / 100
    isLong ? basePrice + slip : basePrice - slip

// Entry logic with safety gate and re-entry confluence check
if buySignal and tradeDir != 1 and not safetyBlocked and allowReentry
    tradeDir      := 1
    activeEntry   := f_adjustedEntry(close, true)
    activeTrigger := swingHighAnchor
    activeSL      := slLongRaw
    stopDist       = activeEntry - activeSL
    activeTP1     := activeEntry + stopDist * tp1R
    activeTP2     := activeEntry + stopDist * tp2R
    activeTP3     := activeEntry + stopDist * tp3R
    activeRR      := tp2R
    activeScore   := scoreBull
    activeGrade   := f_grade(scoreBull, true)
    tradeStatus   := "BUY ACTIVE"
    tp1Hit        := false
    tp2Hit        := false
    trailingActivated := false
    trailingStop  := na
    positionQty   := f_calcPositionSize(activeEntry, activeSL, true)
    remainingQty  := positionQty
    allowReentry  := true
    totalTrades   := totalTrades + 1

if sellSignal and tradeDir != -1 and not safetyBlocked and allowReentry
    tradeDir      := -1
    activeEntry   := f_adjustedEntry(close, false)
    activeTrigger := swingLowAnchor
    activeSL      := slShortRaw
    stopDist2      = activeSL - activeEntry
    activeTP1     := activeEntry - stopDist2 * tp1R
    activeTP2     := activeEntry - stopDist2 * tp2R
    activeTP3     := activeEntry - stopDist2 * tp3R
    activeRR      := tp2R
    activeScore   := scoreBear
    activeGrade   := f_grade(scoreBear, false)
    tradeStatus   := "SELL ACTIVE"
    tp1Hit        := false
    tp2Hit        := false
    trailingActivated := false
    trailingStop  := na
    positionQty   := f_calcPositionSize(activeEntry, activeSL, false)
    remainingQty  := positionQty
    allowReentry  := true
    totalTrades   := totalTrades + 1

// Long trade management
if tradeDir == 1
    slHitNow  := low <= activeSL
    tp3HitNow := high >= activeTP3
    tp2HitNow := high >= activeTP2 and not tp2Hit
    tp1HitNow := high >= activeTP1 and not tp1Hit

    if tp2Hit and useTrailingStop and not trailingActivated
        trailingActivated := true
        trailingStop := high - atrVal * trailingStopAtrMult
    if trailingActivated
        trailingStop := math.max(trailingStop, high - atrVal * trailingStopAtrMult)
        if low <= trailingStop
            slHitNow := true
            activeSL := trailingStop

    if slHitNow
        tradeStatus := "SL HIT"
        tradeDir    := 0
        // P1-3 FIX: Partial exit PnL + remaining position SL
        pnl = (activeEntry - activeSL) * remainingQty
        dailyPnL    := dailyPnL - pnl
        weeklyPnL   := weeklyPnL - pnl
        totalLoss   := totalLoss + pnl
        lossTrades  := lossTrades + 1
        consecutiveLosses := consecutiveLosses + 1
        if consecutiveLosses >= 3
            cooldownRemaining := cooldownBarsAfterLoss
            consecutiveLosses := 0
        lastSlPrice := activeSL
        allowReentry := false
        reentryBars := 0
    else if tp3HitNow
        tradeStatus := "TP3 HIT"
        tradeDir    := 0
        // P1-3 FIX: Remaining position profit
        pnl = (activeTP3 - activeEntry) * remainingQty
        dailyPnL    := dailyPnL + pnl
        weeklyPnL   := weeklyPnL + pnl
        totalProfit := totalProfit + pnl
        winTrades   := winTrades + 1
        consecutiveLosses := 0
    else if tp2HitNow
        tp2Hit      := true
        tradeStatus := "TP2 HIT"
        // P1-3 FIX: Partial exit
        exitQty = remainingQty * (tp2ExitPct / 100)
        pnl = (activeTP2 - activeEntry) * exitQty
        dailyPnL    := dailyPnL + pnl
        weeklyPnL   := weeklyPnL + pnl
        remainingQty := remainingQty - exitQty
        totalProfit := totalProfit + pnl
        consecutiveLosses := 0  // P0-1 FIX
    else if tp1HitNow
        tp1Hit      := true
        tradeStatus := "TP1 HIT"
        // P1-3 FIX: Partial exit
        exitQty = remainingQty * (tp1ExitPct / 100)
        pnl = (activeTP1 - activeEntry) * exitQty
        dailyPnL    := dailyPnL + pnl
        weeklyPnL   := weeklyPnL + pnl
        remainingQty := remainingQty - exitQty
        totalProfit := totalProfit + pnl
        consecutiveLosses := 0  // P0-1 FIX
        if moveSLToBreakeven
            beOffset = (activeTP1 - activeEntry) * beProfitLockPct / 100
            activeSL := activeEntry + beOffset
            beMoveNow := true

// Short trade management
if tradeDir == -1
    slHitNow  := high >= activeSL
    tp3HitNow := low <= activeTP3
    tp2HitNow := low <= activeTP2 and not tp2Hit
    tp1HitNow := low <= activeTP1 and not tp1Hit

    if tp2Hit and useTrailingStop and not trailingActivated
        trailingActivated := true
        trailingStop := low + atrVal * trailingStopAtrMult
    if trailingActivated
        trailingStop := math.min(trailingStop, low + atrVal * trailingStopAtrMult)
        if high >= trailingStop
            slHitNow := true
            activeSL := trailingStop

    if slHitNow
        tradeStatus := "SL HIT"
        tradeDir    := 0
        pnl = (activeSL - activeEntry) * remainingQty
        dailyPnL    := dailyPnL - pnl
        weeklyPnL   := weeklyPnL - pnl
        totalLoss   := totalLoss + pnl
        lossTrades  := lossTrades + 1
        consecutiveLosses := consecutiveLosses + 1
        if consecutiveLosses >= 3
            cooldownRemaining := cooldownBarsAfterLoss
            consecutiveLosses := 0
        lastSlPrice := activeSL
        allowReentry := false
        reentryBars := 0
    else if tp3HitNow
        tradeStatus := "TP3 HIT"
        tradeDir    := 0
        pnl = (activeEntry - activeTP3) * remainingQty
        dailyPnL    := dailyPnL + pnl
        weeklyPnL   := weeklyPnL + pnl
        totalProfit := totalProfit + pnl
        winTrades   := winTrades + 1
        consecutiveLosses := 0
    else if tp2HitNow
        tp2Hit      := true
        tradeStatus := "TP2 HIT"
        exitQty = remainingQty * (tp2ExitPct / 100)
        pnl = (activeEntry - activeTP2) * exitQty
        dailyPnL    := dailyPnL + pnl
        weeklyPnL   := weeklyPnL + pnl
        remainingQty := remainingQty - exitQty
        totalProfit := totalProfit + pnl
        consecutiveLosses := 0  // P0-1 FIX
    else if tp1HitNow
        tp1Hit      := true
        tradeStatus := "TP1 HIT"
        exitQty = remainingQty * (tp1ExitPct / 100)
        pnl = (activeEntry - activeTP1) * exitQty
        dailyPnL    := dailyPnL + pnl
        weeklyPnL   := weeklyPnL + pnl
        remainingQty := remainingQty - exitQty
        totalProfit := totalProfit + pnl
        consecutiveLosses := 0  // P0-1 FIX
        if moveSLToBreakeven
            beOffset = (activeEntry - activeTP1) * beProfitLockPct / 100
            activeSL := activeEntry - beOffset
            beMoveNow := true

// #####################################################################################
// PLOTTING (P2-2 FIX: Transparency 25 instead of 0)
// #####################################################################################
plotshape(buySignal and not safetyBlocked,  title="BUY",  style=shape.triangleup,
     location=location.belowbar, color=colBull, size=size.small, text="BUY")
plotshape(sellSignal and not safetyBlocked, title="SELL", style=shape.triangledown,
     location=location.abovebar, color=colBear, size=size.small, text="SELL")

plot(tradeDir != 0 ? activeSL  : na, title="SL",     color=color.new(colBear, 25), style=plot.style_circles, linewidth=1)
plot(tradeDir != 0 ? activeTP1 : na, title="TP1",    color=color.new(colBull, 25), style=plot.style_circles, linewidth=1)
plot(tradeDir != 0 ? activeTP2 : na, title="TP2",    color=color.new(colBull, 25), style=plot.style_circles, linewidth=1)
plot(tradeDir != 0 ? activeTP3 : na, title="TP3",    color=color.new(colBull, 25), style=plot.style_circles, linewidth=1)
plot(tradeDir != 0 and trailingActivated ? trailingStop : na, title="Trail",
     color=color.new(colWarning, 25), style=plot.style_circles, linewidth=1)

bgcolor(safetyBlocked ? color.new(colDanger, 90) : na, title="Safety Block")

// #####################################################################################
// MODULE 13 — DASHBOARD (P2-1 FIX: Compact mode + caching + visual bars)
// #####################################################################################
f_pos(p) =>
    switch p
        "top_right"    => position.top_right
        "top_left"     => position.top_left
        "bottom_right" => position.bottom_right
        "bottom_left"  => position.bottom_left
        => position.top_right

dTrendTxt   = dBull ? "Bull" : dBear ? "Bear" : "Flat"
h4TrendTxt  = h4Bull ? "Bull" : h4Bear ? "Bear" : "Flat"
m15TrendTxt = m15TrendBull ? "Bull" : m15TrendBear ? "Bear" : "Flat"
trendStatusTxt = "D:" + dTrendTxt + " H4:" + h4TrendTxt + " M15:" + m15TrendTxt

displayDir   = tradeDir != 0 ? tradeDir : (mtfAlignBull ? 1 : mtfAlignBear ? -1 : 0)
displayScore = tradeDir != 0 ? activeScore : (mtfAlignBull ? scoreBull : mtfAlignBear ? scoreBear : math.max(scoreBull, scoreBear))
displayGrade = tradeDir != 0 ? activeGrade : (mtfAlignBull ? f_grade(scoreBull, true) : mtfAlignBear ? f_grade(scoreBear, false) : "D")

var string lastCounterTrend = "-"
if counterTrendBull
    lastCounterTrend := "COUNTER-TREND BUY"
else if counterTrendBear
    lastCounterTrend := "COUNTER-TREND SELL"
else if tradeDir != 0 or mtfAlignBull or mtfAlignBear
    lastCounterTrend := "-"

// P2-1 FIX: Safety reason in main signal
safetyReason = dailyPnL <= -maxDailyLossPct / 100 * accountSize ? "DAILY LIMIT" :
     weeklyPnL <= -maxWeeklyLossPct / 100 * accountSize ? "WEEKLY LIMIT" :
     cooldownRemaining > 0 ? "COOLDOWN" : "BLOCKED"

signalTxt = safetyBlocked ? "SAFETY BLOCK — " + safetyReason :
     tradeDir != 0 ? tradeStatus :
     lastCounterTrend != "-" ? lastCounterTrend + " (Filtered)" :
     mtfAlignBull ? "WATCH — BUY BIAS" :
     mtfAlignBear ? "WATCH — SELL BIAS" : "NO SETUP"

headerCol = safetyBlocked ? colDanger : (displayDir == 1 ? colBull : displayDir == -1 ? colBear : colNeutral)

safetyTxt = safetyBlocked ? safetyReason : "ACTIVE"

// P3-1 FIX: Win rate calculation
winRate = totalTrades > 0 ? float(winTrades) / float(totalTrades) * 100.0 : 0.0
profitFactor = totalLoss > 0 ? totalProfit / totalLoss : (totalProfit > 0 ? 999.0 : 0.0)

// Visual score bar (P3 enhancement)
f_scoreBar(score) =>
    filled = int(score / 10)
    bar = ""
    for i = 0 to 9
        bar := bar + (i < filled ? "█" : "░")
    bar

// P2-1 FIX: Dashboard row count based on compact mode
rows = useCompactDash ? 10 : 20

var table dash = table.new(f_pos(dashPos), 2, rows, border_width=1,
     border_color=color.new(color.gray, 60), bgcolor=colBg)

// P2-1 FIX: Cached table updates — only update changed cells
var string prevSignalTxt = ""
var string prevGrade = ""
var int prevScore = -1

if showDash and barstate.islast
    // Row 0: Header
    table.cell(dash, 0, 0, "IMTF ENGINE V4.1", text_color=color.white, bgcolor=headerCol, text_size=size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    // Row 1: Signal
    if signalTxt != prevSignalTxt
        table.cell(dash, 0, 1, "Signal", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 1, signalTxt, text_color=headerCol, text_halign=text.align_right, text_size=size.small)
        prevSignalTxt := signalTxt

    // Row 2: Grade
    if displayGrade != prevGrade
        table.cell(dash, 0, 2, "Grade", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 2, displayGrade, text_color=headerCol, text_halign=text.align_right, text_size=size.small)
        prevGrade := displayGrade

    // Row 3: Score + visual bar
    if displayScore != prevScore
        table.cell(dash, 0, 3, "Score", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 3, str.tostring(displayScore) + "% " + f_scoreBar(displayScore),
             text_color=color.white, text_halign=text.align_right, text_size=size.small)
        prevScore := displayScore

    // Row 4: Entry
    table.cell(dash, 0, 4, "Entry", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 4, tradeDir != 0 ? str.tostring(activeEntry, format.mintick) : "-",
         text_color=color.white, text_halign=text.align_right, text_size=size.small)

    // Row 5: Position Size
    table.cell(dash, 0, 5, "Size", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 5, tradeDir != 0 ? str.tostring(positionQty, "#.##") + " ct ($" +
         str.tostring(positionQty * activeEntry, "#.") + ")" : "-",
         text_color=color.white, text_halign=text.align_right, text_size=size.small)

    // Row 6: SL
    table.cell(dash, 0, 6, "Stop Loss", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 6, tradeDir != 0 ? str.tostring(activeSL, format.mintick) +
         (tp1Hit and moveSLToBreakeven ? " (PL+" + str.tostring(beProfitLockPct, "#") + "%)" : "") : "-",
         text_color=color.new(colBear, 0), text_halign=text.align_right, text_size=size.small)

    // Row 7: TP1
    table.cell(dash, 0, 7, "TP1", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 7, tradeDir != 0 ? str.tostring(activeTP1, format.mintick) : "-",
         text_color=color.new(colBull, 0), text_halign=text.align_right, text_size=size.small)

    // Row 8: TP2
    table.cell(dash, 0, 8, "TP2", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 8, tradeDir != 0 ? str.tostring(activeTP2, format.mintick) : "-",
         text_color=color.new(colBull, 0), text_halign=text.align_right, text_size=size.small)

    // Row 9: TP3/Trail
    table.cell(dash, 0, 9, "TP3/Trail", text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 9, tradeDir != 0 ? (trailingActivated ? "TRAIL " + str.tostring(trailingStop, format.mintick) :
         str.tostring(activeTP3, format.mintick)) : "-",
         text_color=trailingActivated ? colWarning : color.new(colBull, 0), text_halign=text.align_right, text_size=size.small)

    // Extended rows (only if not compact)
    if not useCompactDash
        table.cell(dash, 0, 10, "R:R", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 10, tradeDir != 0 ? "1 : " + str.tostring(activeRR, "#.##") : "-",
             text_color=color.white, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 11, "Trend", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 11, trendStatusTxt, text_color=color.white, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 12, "ADX", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 12, str.tostring(adxVal, "#.#") + (trendStrengthOk ? " OK" : " weak"),
             text_color=trendStrengthOk ? colBull : colNeutral, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 13, "ATR%", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 13, str.tostring(atrPerc, "#.##") + "%",
             text_color=volatilityOk ? colBull : colNeutral, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 14, "Daily PnL", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 14, str.tostring(dailyPnL, "#.##") + " (" + str.tostring(dailyPnL / accountSize * 100, "#.##") + "%)",
             text_color=dailyPnL >= 0 ? colBull : colBear, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 15, "Weekly PnL", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 15, str.tostring(weeklyPnL, "#.##") + " (" + str.tostring(weeklyPnL / accountSize * 100, "#.##") + "%)",
             text_color=weeklyPnL >= 0 ? colBull : colBear, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 16, "Safety", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 16, safetyTxt, text_color=safetyBlocked ? colDanger : colBull,
             text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 17, "Consec SL", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 17, str.tostring(consecutiveLosses) + "/3 (CD:" + str.tostring(cooldownRemaining) + ")",
             text_color=consecutiveLosses >= 2 ? colWarning : color.white, text_halign=text.align_right, text_size=size.small)

        // P3-1 FIX: Trade statistics
        table.cell(dash, 0, 18, "Win Rate", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 18, str.tostring(winRate, "#.##") + "% (" + str.tostring(winTrades) + "/" + str.tostring(totalTrades) + ")",
             text_color=winRate >= 50 ? colBull : colBear, text_halign=text.align_right, text_size=size.small)

        table.cell(dash, 0, 19, "Profit Factor", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 19, profitFactor >= 999 ? "∞" : str.tostring(profitFactor, "#.##"),
             text_color=profitFactor >= 1.5 ? colBull : profitFactor >= 1.0 ? colWarning : colBear,
             text_halign=text.align_right, text_size=size.small)

// #####################################################################################
// MODULE 14 — ALERTS (P3-3: Enhanced webhook format)
// #####################################################################################
alertcondition(buySignal and not safetyBlocked, title="Institutional BUY",
     message="BUY | {{ticker}} | Price: {{close}} | Time: {{time}}")
alertcondition(sellSignal and not safetyBlocked, title="Institutional SELL",
     message="SELL | {{ticker}} | Price: {{close}} | Time: {{time}}")
alertcondition(tp1HitNow, title="TP1 Hit",
     message="TP1 | {{ticker}} | Price: {{close}} | Partial exit executed")
alertcondition(tp2HitNow, title="TP2 Hit",
     message="TP2 | {{ticker}} | Price: {{close}} | Trailing stop activated")
alertcondition(tp3HitNow, title="TP3 Hit",
     message="TP3 | {{ticker}} | Price: {{close}} | Trade complete")
alertcondition(slHitNow, title="SL Hit",
     message="SL | {{ticker}} | Price: {{close}} | Trade closed")
alertcondition(beMoveNow, title="Profit Lock",
     message="PL | {{ticker}} | Price: {{close}} | SL moved to profit lock")
alertcondition(safetyBlocked and not safetyBlocked[1], title="SAFETY BLOCK",
     message="SAFETY BLOCK | {{ticker}} | Trading paused | Check dashboard")
